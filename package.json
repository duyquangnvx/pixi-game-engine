{
  "name": "@duyquangnvx/pixi-game-engine",
  "version": "0.1.5",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@pixi/particle-emitter": "^5.0.10",
    "@pixi/sound": "^5.2.3",
    "@pixi/ui": "^1.2.4",
    "gsap": "^3.12.7",
    "pixi-spine": "^4.0.5",
    "pixi.js": "^7.4.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "pixi.js": "^7.0.0"
  }
}